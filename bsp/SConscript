# -*- python -*-
"""
SCons script for Board Support Package (BSP) and Target Linking
Builds freertos_smp.elf and freertos_smp.bin
"""
from SCons.Script import *
from arch.rules import setup_linker_rules

Import('env', 'kernel_lib', 'cherry_kal_lib', 'cherry_vfs_lib', 'cherry_shell_lib', 'cherry_printk_lib', 'cherry_timer_lib', 'cherry_pci_lib', 'cherry_sdio_lib', 'cherry_ext4_lib', 'cherry_fstools_lib', 'cherry_net_lib', 'cherry_nvme_lib', 'cherry_ahci_lib', 'cherry_usbd_lib', 'cherry_process_lib')

bsp_env = env.Clone()

# Setup linker script and bare-metal linking flags
setup_linker_rules(bsp_env, '#bsp/linker.ld')

# BSP include search paths
bsp_env.Append(CPPPATH=[
    '#bsp/include',
    '#components/cherry_printk/include',
    '#components/cherry_printk/tests',
    '#components/cherry_timer/include',
    '#components/cherry_timer/tests',
    '#components/cherry_pci/include',
    '#components/cherry_pci/tests',
    '#components/cherry_sdio/include',
    '#components/cherry_sdio/tests',
    '#components/cherry_ext4/include',
    '#components/cherry_ext4/tests',
    '#components/cherry_fstools/include',
    '#components/cherry_fstools/tests',
    '#components/cherry_net/include',
    '#components/cherry_net/tests',
    '#components/cherry_nvme/include',
    '#components/cherry_nvme/tests',
    '#components/cherry_ahci/include',
    '#components/cherry_ahci/tests',
    '#components/cherry_usbd/include',
    '#components/cherry_usbd/tests',
    '#components/cherry_process/include',
    '#components/cherry_process/tests',
    '#components/cherry_shell/include',
    '#components/cherry_shell/tests',
    '#components/cherry_kal/include',
    '#components/cherry_vfs/include',
    '#components/cherry_vfs/tests',
    '#include',
    '#kernel/include',
    '#kernel/portable/GCC/ARM_AARCH64_SRE',
    '#arch/include',
])

bsp_sources = [
    'src/main.c',
    'src/ukernel.c',
    'src/port_fatal.c',
    'src/app.c',
    'src/uart.c',
    'src/gic.c',
    'src/gtimer.c',
    'src/app_irq.c',
    'src/string.c',
    'src/startup.S',
    'src/freertos_vectors.S',
]

bsp_objs = bsp_env.Object(bsp_sources)

# Link ELF image with libraries in dependency order:
# cherry_process -> cherry_usbd -> cherry_ahci -> cherry_nvme -> cherry_net -> cherry_fstools -> cherry_ext4 -> cherry_sdio -> cherry_pci -> cherry_shell -> cherry_vfs -> cherry_timer -> cherry_printk -> cherry_kal -> freertos kernel
elf_target = bsp_env.Program(
    target='freertos_smp.elf',
    source=bsp_objs + [cherry_process_lib, cherry_usbd_lib, cherry_ahci_lib, cherry_nvme_lib, cherry_net_lib, cherry_fstools_lib, cherry_ext4_lib, cherry_sdio_lib, cherry_pci_lib, cherry_shell_lib, cherry_vfs_lib, cherry_timer_lib, cherry_printk_lib, cherry_kal_lib, kernel_lib]
)


# Generate raw binary image
bin_target = bsp_env.Command(
    target='freertos_smp.bin',
    source=elf_target,
    action='$OBJCOPY -O binary $SOURCE $TARGET'
)

Return('elf_target bin_target')
