# -*- python -*-
from SCons.Script import *

Import('env')

sdio_env = env.Clone()

sdio_env.Append(CPPPATH=[
    '#components/cherry_sdio/include',
    '#components/cherry_sdio/tests',
    '#components/cherry_pci/include',
    '#components/cherry_pci/tests',
    '#components/cherry_vfs/include',
    '#components/cherry_vfs/tests',
    '#components/cherry_kal/include',
    '#components/cherry_printk/include',
    '#components/cherry_shell/include',
    '#include',
    '#bsp/include',
    '#arch/include',
])

sources = [
    'src/cherry_sdio.c',
    'src/sdhci.c',
    'src/sd_card.c',
    'src/sdhci_pci.c',
    'src/sd_block.c',
    'src/sd_cmd.c',
    'tests/sdio_test.c',
]

sdio_objs = sdio_env.Object(sources)

cherry_sdio_lib = sdio_env.Library(
    target='libcherry_sdio.a',
    source=sdio_objs
)

Return('cherry_sdio_lib')
